<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MobileEssControl.ViewModels"
        x:DataType="vm:MainWindowViewModel"
        x:Class="MobileEssControl.Views.MainWindow"

        WindowStartupLocation="CenterScreen"
        Width="1920"
        Height="1080"
        WindowState="Maximized"
        Title="Mobile ESS Control System">

    <Grid RowDefinitions="*,128"
          Background="#F1F5F9">

        <!-- 하단 공통 헤더 -->
        <Border Grid.Row="1"
                Background="#0F172A"
                Padding="40,0">

            <Grid ColumnDefinitions="*,Auto">

                <!-- 로고 / 시스템명 -->
                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Spacing="22">

                    <!--
                        관리자 진입용 숨김 터치 영역입니다.
                        일반 관리자 버튼은 표시하지 않고 ESS 로고를 터치하면
                        숫자 비밀번호 입력창이 열립니다.
                    -->
                    <Button Width="70"
                            Height="70"
                            Padding="0"
                            CornerRadius="18"
                            Background="#2563EB"
                            BorderBrush="#2563EB"
                            Command="{Binding ShowAdminCommand}"
                            IsEnabled="{Binding IsAdminMenuEnabled}">

                        <TextBlock Text="ESS"
                                   Foreground="White"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Button>

                    <StackPanel VerticalAlignment="Center">

                        <TextBlock Text="Mobile ESS Control System"
                                   Foreground="White"
                                   FontSize="36"
                                   FontWeight="Bold"/>

                        <TextBlock Text="77.4kWh / 44kW Mobile Energy Control"
                                   Foreground="#94A3B8"
                                   FontSize="19"/>
                    </StackPanel>
                </StackPanel>

                <!-- 실제 조작 패널 LED / 연결 / 메뉴 -->
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Spacing="22">

                    <!--
                        실제 패널 표시등 매핑
                        P/W      : 31023 Bit11 PowerSwitchSts
                        입/출력   : 31022 Bit14 LampOutput
                        알람      : 31022 Bit12 LampAlarm
                        고장      : 31022 Bit13 LampFault
                        비상정지  : 31023 Bit10 EmStopSwitchSts
                    -->
                    <Border Background="#111827"
                            BorderBrush="#334155"
                            BorderThickness="2"
                            CornerRadius="20"
                            Padding="18,10">

                        <StackPanel Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    Spacing="18">

                            <!-- P/W -->
                            <StackPanel Width="72"
                                        Spacing="4"
                                        ToolTip.Tip="{Binding PowerLedStateText}">

                                <Border Width="60"
                                        Height="60"
                                        CornerRadius="19"
                                        Background="#020617"
                                        BorderBrush="#64748B"
                                        BorderThickness="1"
                                        Padding="4"
                                        HorizontalAlignment="Center">

                                    <Border CornerRadius="14"
                                            Background="{Binding PowerLedBrush}"/>
                                </Border>

                                <TextBlock Text="P/W"
                                           Foreground="#E2E8F0"
                                           FontSize="17"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>

                            <!-- 입/출력 -->
                            <StackPanel Width="82"
                                        Spacing="4"
                                        ToolTip.Tip="{Binding OutputLedStateText}">

                                <Border Width="60"
                                        Height="60"
                                        CornerRadius="19"
                                        Background="#020617"
                                        BorderBrush="#64748B"
                                        BorderThickness="1"
                                        Padding="4"
                                        HorizontalAlignment="Center">

                                    <Border CornerRadius="14"
                                            Background="{Binding OutputLedBrush}"/>
                                </Border>

                                <TextBlock Text="입/출력"
                                           Foreground="#E2E8F0"
                                           FontSize="17"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>

                            <!-- 알람 -->
                            <StackPanel Width="72"
                                        Spacing="4"
                                        ToolTip.Tip="{Binding AlarmLedStateText}">

                                <Border Width="60"
                                        Height="60"
                                        CornerRadius="19"
                                        Background="#020617"
                                        BorderBrush="#64748B"
                                        BorderThickness="1"
                                        Padding="4"
                                        HorizontalAlignment="Center">

                                    <Border CornerRadius="14"
                                            Background="{Binding AlarmLedBrush}"/>
                                </Border>

                                <TextBlock Text="알람"
                                           Foreground="#E2E8F0"
                                           FontSize="17"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>

                            <!-- 고장 -->
                            <StackPanel Width="72"
                                        Spacing="4"
                                        ToolTip.Tip="{Binding FaultLedStateText}">

                                <Border Width="60"
                                        Height="60"
                                        CornerRadius="19"
                                        Background="#020617"
                                        BorderBrush="#64748B"
                                        BorderThickness="1"
                                        Padding="4"
                                        HorizontalAlignment="Center">

                                    <Border CornerRadius="14"
                                            Background="{Binding FaultLedBrush}"/>
                                </Border>

                                <TextBlock Text="고장"
                                           Foreground="#E2E8F0"
                                           FontSize="17"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>

                            <!-- 비상정지 -->
                            <StackPanel Width="100"
                                        Spacing="4"
                                        ToolTip.Tip="{Binding EmergencyStopStateText}">

                                <Border Width="60"
                                        Height="60"
                                        CornerRadius="30"
                                        Background="#020617"
                                        BorderBrush="#64748B"
                                        BorderThickness="1"
                                        Padding="4"
                                        HorizontalAlignment="Center">

                                    <Border CornerRadius="26"
                                            Background="{Binding EmergencyStopLedBrush}"/>
                                </Border>

                                <TextBlock Text="비상정지"
                                           Foreground="#E2E8F0"
                                           FontSize="16"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- EMS 연결 + 전체 운전 상태 공통 표시 -->
                    <Border Background="#1E293B"
                            BorderBrush="#334155"
                            BorderThickness="1"
                            CornerRadius="20"
                            Padding="22,13"
                            MinWidth="580"
                            MaxWidth="800">

                        <TextBlock Text="{Binding ConnectionStatus}"
                                   Foreground="{Binding ConnectionStatusBrush}"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   TextAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center"
                                   ToolTip.Tip="{Binding ConnectionStatus}"/>
                    </Border>

                    <Button Content="메인화면"
                            Command="{Binding ShowModeSelectCommand}"
                            IsEnabled="{Binding IsModeSelectNavigationEnabled}"
                            Height="66"
                            Padding="28,0"
                            FontSize="19"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            Background="#2563EB"
                            Foreground="White"
                            BorderBrush="#1D4ED8"/>

                </StackPanel>
            </Grid>
        </Border>

        <!-- 페이지 영역 -->
        <Grid Grid.Row="0">

            <Border Padding="22"
                    Background="#F1F5F9">

                <ContentControl Content="{ReflectionBinding CurrentPage}"/>
            </Border>
        </Grid>

    </Grid>
</Window>
