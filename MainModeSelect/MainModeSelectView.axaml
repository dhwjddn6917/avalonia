<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MobileEssControl.ViewModels.MainModeSelect"
             x:DataType="vm:MainModeSelectViewModel"
             x:Class="MobileEssControl.Views.MainModeSelect.MainModeSelectView">

    <UserControl.Styles>

        <!-- 모든 운전 모드 버튼 공통 (한 줄 배치용 고정 크기) -->
        <Style Selector="Button.mode-card">
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="CornerRadius" Value="30"/>
            <Setter Property="Padding" Value="32"/>
            <Setter Property="Width" Value="600"/>
            <Setter Property="Height" Value="480"/>
        </Style>

        <!-- 버튼 제목 공통 : 버튼 상단 중앙에 고정 -->
        <Style Selector="TextBlock.mode-title">
            <Setter Property="FontSize" Value="46"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="Margin" Value="0,10,0,0"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Width" Value="520"/>
        </Style>

        <!-- 버튼 설명 공통 -->
        <Style Selector="TextBlock.mode-description">
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>

        <!-- 전력 흐름 아이콘 배경 칩 (레인 색상별, 버튼 중앙에 크게) -->
        <Style Selector="Border.icon-chip">
            <Setter Property="Width" Value="128"/>
            <Setter Property="Height" Value="128"/>
            <Setter Property="CornerRadius" Value="28"/>
        </Style>
        <Style Selector="Border.icon-chip.charge">
            <Setter Property="Background" Value="#D1FAE5"/>
        </Style>
        <Style Selector="Border.icon-chip.output">
            <Setter Property="Background" Value="#DBEAFE"/>
        </Style>
        <Style Selector="Border.icon-chip.discharge">
            <Setter Property="Background" Value="#FFEDD5"/>
        </Style>

        <!-- 흐름 화살표 배경 트랙 (연한 고정선) -->
        <Style Selector="Line.arrow-track">
            <Setter Property="Stroke" Value="#CBD5E1"/>
            <Setter Property="StrokeThickness" Value="4"/>
            <Setter Property="StrokeLineCap" Value="Round"/>
        </Style>

        <!-- 흐름 화살표 (점선이 흐르는 애니메이션, 레인 색상별) -->
        <Style Selector="Line.arrow-flow">
            <Setter Property="StrokeThickness" Value="4"/>
            <Setter Property="StrokeLineCap" Value="Round"/>
            <Setter Property="StrokeDashArray" Value="7,7"/>
            <Style.Animations>
                <Animation Duration="0:0:0.9" IterationCount="INFINITE">
                    <KeyFrame Cue="0%">
                        <Setter Property="StrokeDashOffset" Value="0"/>
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="StrokeDashOffset" Value="-28"/>
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <Style Selector="Line.arrow-flow.charge">
            <Setter Property="Stroke" Value="#15803D"/>
        </Style>
        <Style Selector="Line.arrow-flow.output">
            <Setter Property="Stroke" Value="#1D4ED8"/>
        </Style>
        <Style Selector="Line.arrow-flow.discharge">
            <Setter Property="Stroke" Value="#C2410C"/>
        </Style>

        <Style Selector="Polygon.arrow-head">
            <Setter Property="Points" Value="0,0 13,7 0,14"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="Polygon.arrow-head.charge">
            <Setter Property="Fill" Value="#15803D"/>
        </Style>
        <Style Selector="Polygon.arrow-head.output">
            <Setter Property="Fill" Value="#1D4ED8"/>
        </Style>
        <Style Selector="Polygon.arrow-head.discharge">
            <Setter Property="Fill" Value="#C2410C"/>
        </Style>

    </UserControl.Styles>

    <Grid Background="#F1F5F9">

        <!-- 회사 로고 + 운전 모드 3개를 화면 중앙에 세로로 배치 (전체적으로 살짝 위로) -->
        <StackPanel HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Margin="0,0,0,140"
                    Spacing="72">

            <!-- 회사 로고 (EVKMC) -->
            <Image Source="avares://MobileEssControl/Assets/evkmc-logo.png"
                   Width="560"
                   Stretch="Uniform"
                   HorizontalAlignment="Center"/>

            <!-- 운전 모드 3개를 한 줄로 배치 -->
            <StackPanel Orientation="Horizontal"
                        Spacing="32"
                        HorizontalAlignment="Center">

                <!-- 배터리 충전 : AC 콘센트 -> 인버터 -> 배터리 -->
                <Button Classes="mode-card"
                        Command="{Binding ShowAutoChargeCommand}"
                        Background="#ECFDF5"
                        BorderBrush="#86EFAC">

                    <!-- 제목은 상단 고정, 아이콘 흐름은 버튼 중앙에 크게 -->
                    <Grid>

                        <TextBlock Classes="mode-title"
                                   Text="배터리 충전"
                                   Foreground="#15803D"/>

                        <Grid ColumnDefinitions="128,*,128,*,128"
                              Width="520"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center">

                            <!-- AC 콘센트 -->
                            <Border Grid.Column="0" Classes="icon-chip charge">
                                <Viewbox Margin="30">
                                    <Canvas Width="24" Height="24">
                                        <Line StartPoint="9,2.5" EndPoint="9,8" Stroke="#15803D" StrokeThickness="2.4" StrokeLineCap="Round"/>
                                        <Line StartPoint="15,2.5" EndPoint="15,8" Stroke="#15803D" StrokeThickness="2.4" StrokeLineCap="Round"/>
                                        <Rectangle Canvas.Left="6" Canvas.Top="8" Width="12" Height="9" RadiusX="3" RadiusY="3" Stroke="#15803D" StrokeThickness="2.4"/>
                                        <Path Data="M13.6,10.3 L10.4,14.5 L12.8,14.5 L11.2,18.2 L15.2,13.2 L12.6,13.2 Z" Fill="#15803D"/>
                                    </Canvas>
                                </Viewbox>
                            </Border>

                            <Grid Grid.Column="1" Height="32">
                                <Line Classes="arrow-track" StartPoint="6,16" EndPoint="60,16"/>
                                <Line Classes="arrow-flow charge" StartPoint="6,16" EndPoint="60,16"/>
                                <Polygon Classes="arrow-head charge"/>
                            </Grid>

                            <!-- 인버터 -->
                            <Border Grid.Column="2" Classes="icon-chip charge">
                                <Viewbox Margin="26">
                                    <Canvas Width="40" Height="40">
                                        <Rectangle Canvas.Left="2" Canvas.Top="2" Width="36" Height="36" RadiusX="10" RadiusY="10" Stroke="#15803D" StrokeThickness="2.4"/>
                                        <Path Data="M6.5,13 Q10.5,7 14.5,13 T22.5,13" Stroke="#15803D" StrokeThickness="2.4" StrokeLineCap="Round"/>
                                        <Line StartPoint="33,7" EndPoint="7,33" Stroke="#15803D" StrokeThickness="2.4" StrokeLineCap="Round"/>
                                        <Line StartPoint="22,27" EndPoint="34,27" Stroke="#15803D" StrokeThickness="3" StrokeLineCap="Round"/>
                                        <Line StartPoint="22,32" EndPoint="27,32" Stroke="#15803D" StrokeThickness="3" StrokeLineCap="Round"/>
                                        <Line StartPoint="29,32" EndPoint="34,32" Stroke="#15803D" StrokeThickness="3" StrokeLineCap="Round"/>
                                    </Canvas>
                                </Viewbox>
                            </Border>

                            <Grid Grid.Column="3" Height="32">
                                <Line Classes="arrow-track" StartPoint="6,16" EndPoint="60,16"/>
                                <Line Classes="arrow-flow charge" StartPoint="6,16" EndPoint="60,16"/>
                                <Polygon Classes="arrow-head charge"/>
                            </Grid>

                            <!-- 배터리 -->
                            <Border Grid.Column="4" Classes="icon-chip charge">
                                <Viewbox Margin="30">
                                    <Canvas Width="24" Height="28">
                                        <Rectangle Canvas.Left="7" Canvas.Top="2" Width="10" Height="4" RadiusX="1.5" RadiusY="1.5" Fill="#15803D"/>
                                        <Rectangle Canvas.Left="3" Canvas.Top="6" Width="18" Height="20" RadiusX="4" RadiusY="4" Fill="#15803D"/>
                                        <Rectangle Canvas.Left="6" Canvas.Top="9" Width="12" Height="14" RadiusX="2" RadiusY="2" Fill="#D1FAE5"/>
                                    </Canvas>
                                </Viewbox>
                            </Border>

                        </Grid>
                    </Grid>
                </Button>

                <!-- 인버터 출력 : 배터리 -> 인버터 -> 출력 콘센트 -->
                <Button Classes="mode-card"
                        Command="{Binding ShowExternalOutputCommand}"
                        Background="#EFF6FF"
                        BorderBrush="#93C5FD">

                    <Grid>

                        <TextBlock Classes="mode-title"
                                   Text="인버터 출력"
                                   Foreground="#1D4ED8"/>

                        <Grid ColumnDefinitions="128,*,128,*,128"
                              Width="520"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center">

                            <!-- 배터리 -->
                            <Border Grid.Column="0" Classes="icon-chip output">
                                <Viewbox Margin="30">
                                    <Canvas Width="24" Height="28">
                                        <Rectangle Canvas.Left="7" Canvas.Top="2" Width="10" Height="4" RadiusX="1.5" RadiusY="1.5" Fill="#1D4ED8"/>
                                        <Rectangle Canvas.Left="3" Canvas.Top="6" Width="18" Height="20" RadiusX="4" RadiusY="4" Fill="#1D4ED8"/>
                                        <Rectangle Canvas.Left="6" Canvas.Top="9" Width="12" Height="14" RadiusX="2" RadiusY="2" Fill="#DBEAFE"/>
                                    </Canvas>
                                </Viewbox>
                            </Border>

                            <Grid Grid.Column="1" Height="32">
                                <Line Classes="arrow-track" StartPoint="6,16" EndPoint="60,16"/>
                                <Line Classes="arrow-flow output" StartPoint="6,16" EndPoint="60,16"/>
                                <Polygon Classes="arrow-head output"/>
                            </Grid>

                            <!-- 인버터 -->
                            <Border Grid.Column="2" Classes="icon-chip output">
                                <Viewbox Margin="26">
                                    <Canvas Width="40" Height="40">
                                        <Rectangle Canvas.Left="2" Canvas.Top="2" Width="36" Height="36" RadiusX="10" RadiusY="10" Stroke="#1D4ED8" StrokeThickness="2.4"/>
                                        <Path Data="M6.5,13 Q10.5,7 14.5,13 T22.5,13" Stroke="#1D4ED8" StrokeThickness="2.4" StrokeLineCap="Round"/>
                                        <Line StartPoint="33,7" EndPoint="7,33" Stroke="#1D4ED8" StrokeThickness="2.4" StrokeLineCap="Round"/>
                                        <Line StartPoint="22,27" EndPoint="34,27" Stroke="#1D4ED8" StrokeThickness="3" StrokeLineCap="Round"/>
                                        <Line StartPoint="22,32" EndPoint="27,32" Stroke="#1D4ED8" StrokeThickness="3" StrokeLineCap="Round"/>
                                        <Line StartPoint="29,32" EndPoint="34,32" Stroke="#1D4ED8" StrokeThickness="3" StrokeLineCap="Round"/>
                                    </Canvas>
                                </Viewbox>
                            </Border>

                            <Grid Grid.Column="3" Height="32">
                                <Line Classes="arrow-track" StartPoint="6,16" EndPoint="60,16"/>
                                <Line Classes="arrow-flow output" StartPoint="6,16" EndPoint="60,16"/>
                                <Polygon Classes="arrow-head output"/>
                            </Grid>

                            <!-- 출력 콘센트 -->
                            <Border Grid.Column="4" Classes="icon-chip output">
                                <Viewbox Margin="30">
                                    <Canvas Width="24" Height="24">
                                        <Line StartPoint="9,2.5" EndPoint="9,8" Stroke="#1D4ED8" StrokeThickness="2.4" StrokeLineCap="Round"/>
                                        <Line StartPoint="15,2.5" EndPoint="15,8" Stroke="#1D4ED8" StrokeThickness="2.4" StrokeLineCap="Round"/>
                                        <Rectangle Canvas.Left="6" Canvas.Top="8" Width="12" Height="9" RadiusX="3" RadiusY="3" Stroke="#1D4ED8" StrokeThickness="2.4"/>
                                        <Path Data="M13.6,10.3 L10.4,14.5 L12.8,14.5 L11.2,18.2 L15.2,13.2 L12.6,13.2 Z" Fill="#1D4ED8"/>
                                    </Canvas>
                                </Viewbox>
                            </Border>

                        </Grid>
                    </Grid>
                </Button>

                <!-- 인버터 출력(계통) : 배터리 -> 인버터 -> 계통(송전탑) -->
                <Button Classes="mode-card"
                        Command="{Binding ShowGridDischargeCommand}"
                        Background="#FFF7ED"
                        BorderBrush="#FDBA74">

                    <Grid>

                        <TextBlock Classes="mode-title"
                                   Text="인버터 출력(계통)"
                                   Foreground="#C2410C"/>

                        <Grid ColumnDefinitions="128,*,128,*,128"
                              Width="520"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center">

                            <!-- 배터리 -->
                            <Border Grid.Column="0" Classes="icon-chip discharge">
                                <Viewbox Margin="30">
                                    <Canvas Width="24" Height="28">
                                        <Rectangle Canvas.Left="7" Canvas.Top="2" Width="10" Height="4" RadiusX="1.5" RadiusY="1.5" Fill="#C2410C"/>
                                        <Rectangle Canvas.Left="3" Canvas.Top="6" Width="18" Height="20" RadiusX="4" RadiusY="4" Fill="#C2410C"/>
                                        <Rectangle Canvas.Left="6" Canvas.Top="9" Width="12" Height="14" RadiusX="2" RadiusY="2" Fill="#FFEDD5"/>
                                    </Canvas>
                                </Viewbox>
                            </Border>

                            <Grid Grid.Column="1" Height="32">
                                <Line Classes="arrow-track" StartPoint="6,16" EndPoint="60,16"/>
                                <Line Classes="arrow-flow discharge" StartPoint="6,16" EndPoint="60,16"/>
                                <Polygon Classes="arrow-head discharge"/>
                            </Grid>

                            <!-- 인버터 -->
                            <Border Grid.Column="2" Classes="icon-chip discharge">
                                <Viewbox Margin="26">
                                    <Canvas Width="40" Height="40">
                                        <Rectangle Canvas.Left="2" Canvas.Top="2" Width="36" Height="36" RadiusX="10" RadiusY="10" Stroke="#C2410C" StrokeThickness="2.4"/>
                                        <Path Data="M6.5,13 Q10.5,7 14.5,13 T22.5,13" Stroke="#C2410C" StrokeThickness="2.4" StrokeLineCap="Round"/>
                                        <Line StartPoint="33,7" EndPoint="7,33" Stroke="#C2410C" StrokeThickness="2.4" StrokeLineCap="Round"/>
                                        <Line StartPoint="22,27" EndPoint="34,27" Stroke="#C2410C" StrokeThickness="3" StrokeLineCap="Round"/>
                                        <Line StartPoint="22,32" EndPoint="27,32" Stroke="#C2410C" StrokeThickness="3" StrokeLineCap="Round"/>
                                        <Line StartPoint="29,32" EndPoint="34,32" Stroke="#C2410C" StrokeThickness="3" StrokeLineCap="Round"/>
                                    </Canvas>
                                </Viewbox>
                            </Border>

                            <Grid Grid.Column="3" Height="32">
                                <Line Classes="arrow-track" StartPoint="6,16" EndPoint="60,16"/>
                                <Line Classes="arrow-flow discharge" StartPoint="6,16" EndPoint="60,16"/>
                                <Polygon Classes="arrow-head discharge"/>
                            </Grid>

                            <!-- 계통 (송전탑) -->
                            <Border Grid.Column="4" Classes="icon-chip discharge">
                                <Viewbox Margin="30">
                                    <Canvas Width="32" Height="40">
                                        <Line StartPoint="16,3" EndPoint="6,15" Stroke="#C2410C" StrokeThickness="2.2" StrokeLineCap="Round"/>
                                        <Line StartPoint="16,3" EndPoint="26,15" Stroke="#C2410C" StrokeThickness="2.2" StrokeLineCap="Round"/>
                                        <Line StartPoint="6,15" EndPoint="26,15" Stroke="#C2410C" StrokeThickness="2.2" StrokeLineCap="Round"/>
                                        <Line StartPoint="6,15" EndPoint="3,26" Stroke="#C2410C" StrokeThickness="2.2" StrokeLineCap="Round"/>
                                        <Line StartPoint="26,15" EndPoint="29,26" Stroke="#C2410C" StrokeThickness="2.2" StrokeLineCap="Round"/>
                                        <Line StartPoint="3,26" EndPoint="29,26" Stroke="#C2410C" StrokeThickness="2.2" StrokeLineCap="Round"/>
                                        <Line StartPoint="6,15" EndPoint="29,26" Stroke="#C2410C" StrokeThickness="2.2" StrokeLineCap="Round"/>
                                        <Line StartPoint="26,15" EndPoint="3,26" Stroke="#C2410C" StrokeThickness="2.2" StrokeLineCap="Round"/>
                                        <Line StartPoint="3,26" EndPoint="2,36" Stroke="#C2410C" StrokeThickness="2.2" StrokeLineCap="Round"/>
                                        <Line StartPoint="29,26" EndPoint="30,36" Stroke="#C2410C" StrokeThickness="2.2" StrokeLineCap="Round"/>
                                        <Rectangle Canvas.Left="1" Canvas.Top="36" Width="30" Height="3" RadiusX="1" RadiusY="1" Fill="#C2410C"/>
                                        <Rectangle Canvas.Left="4" Canvas.Top="13.5" Width="4" Height="3" Fill="#C2410C"/>
                                        <Rectangle Canvas.Left="24" Canvas.Top="13.5" Width="4" Height="3" Fill="#C2410C"/>
                                        <Rectangle Canvas.Left="1" Canvas.Top="24.5" Width="4" Height="3" Fill="#C2410C"/>
                                        <Rectangle Canvas.Left="27" Canvas.Top="24.5" Width="4" Height="3" Fill="#C2410C"/>
                                    </Canvas>
                                </Viewbox>
                            </Border>

                        </Grid>
                    </Grid>
                </Button>

            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>
