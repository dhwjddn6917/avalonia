<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MobileEssControl.ViewModels.MainModeSelect"
             x:DataType="vm:MainModeSelectViewModel"
             x:Class="MobileEssControl.Views.MainModeSelect.MainModeSelectView">

    <UserControl.Styles>

        <!-- 모든 운전 모드 버튼 공통 (한 줄 배치용 고정 크기) -->
        <Style Selector="Button.mode-card">
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="CornerRadius" Value="28"/>
            <Setter Property="Padding" Value="28"/>
            <Setter Property="Width" Value="440"/>
            <Setter Property="Height" Value="270"/>
        </Style>

        <!-- 버튼 제목 공통 -->
        <Style Selector="TextBlock.mode-title">
            <Setter Property="FontSize" Value="42"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>

        <!-- 버튼 설명 공통 -->
        <Style Selector="TextBlock.mode-description">
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>

    </UserControl.Styles>

    <Grid Background="#F1F5F9">

        <!-- 회사 로고 + 운전 모드 3개를 화면 중앙에 세로로 배치 -->
        <StackPanel HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="64">

            <!-- 회사 로고 (EVKMC) -->
            <Image Source="avares://MobileEssControl/Assets/evkmc-logo.png"
                   Width="420"
                   Stretch="Uniform"
                   HorizontalAlignment="Center"/>

            <!-- 운전 모드 3개를 한 줄로 배치 -->
            <StackPanel Orientation="Horizontal"
                        Spacing="40"
                        HorizontalAlignment="Center">

                <!-- 배터리 충전 -->
                <Button Classes="mode-card"
                        Command="{Binding ShowAutoChargeCommand}"
                        Background="#ECFDF5"
                        BorderBrush="#86EFAC">

                    <StackPanel Spacing="8"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">

                        <TextBlock Classes="mode-title"
                                   Text="배터리 충전"
                                   Foreground="#15803D"/>
                    </StackPanel>
                </Button>

                <!-- 외부 출력 -->
                <Button Classes="mode-card"
                        Command="{Binding ShowExternalOutputCommand}"
                        Background="#EFF6FF"
                        BorderBrush="#93C5FD">

                    <StackPanel Spacing="8"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">

                        <TextBlock Classes="mode-title"
                                   Text="외부 출력"
                                   Foreground="#1D4ED8"/>
                    </StackPanel>
                </Button>

                <!-- 계통 방전 -->
                <Button Classes="mode-card"
                        Command="{Binding ShowGridDischargeCommand}"
                        Background="#FFF7ED"
                        BorderBrush="#FDBA74">

                    <StackPanel Spacing="8"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">

                        <TextBlock Classes="mode-title"
                                   Text="계통 방전"
                                   Foreground="#C2410C"/>
                    </StackPanel>
                </Button>

            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>
