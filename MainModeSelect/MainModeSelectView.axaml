<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MobileEssControl.ViewModels.MainModeSelect"
             x:DataType="vm:MainModeSelectViewModel"
             x:Class="MobileEssControl.Views.MainModeSelect.MainModeSelectView">

    <UserControl.Styles>

        <!--
            Button에는 BoxShadow 속성이 없어서(Border 전용), 그림자는 바깥쪽
            Border(mode-shadow)가 지고 안쪽 Button(mode-card)이 실제 색상/내용을 담당합니다.
        -->
        <Style Selector="Border.mode-shadow">
            <Setter Property="CornerRadius" Value="30"/>
            <Setter Property="Margin" Value="16,0"/>
            <Setter Property="BoxShadow" Value="0 10 26 -2 #3A000000"/>
        </Style>
        <Style Selector="Border.mode-shadow:pointerover">
            <Setter Property="BoxShadow" Value="0 14 30 -2 #4D000000"/>
        </Style>

        <!-- 모든 운전 모드 버튼 공통 : 셀을 꽉 채우고, 눌림 효과로 버튼감을 줍니다 -->
        <Style Selector="Button.mode-card">
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="CornerRadius" Value="30"/>
            <Setter Property="Padding" Value="28"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
        </Style>
        <Style Selector="Button.mode-card:pressed">
            <Setter Property="RenderTransform" Value="scale(0.97)"/>
        </Style>

        <!-- 버튼 제목 공통 : 버튼 상단 중앙에 고정 -->
        <Style Selector="TextBlock.mode-title">
            <Setter Property="FontSize" Value="46"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Width" Value="520"/>
        </Style>

        <!-- 전력 흐름 아이콘 배경 칩 (레인 색상별) -->
        <Style Selector="Border.icon-chip">
            <Setter Property="Width" Value="140"/>
            <Setter Property="Height" Value="140"/>
            <Setter Property="CornerRadius" Value="32"/>
        </Style>
        <Style Selector="Border.icon-chip.charge">
            <Setter Property="Background" Value="#D1FAE5"/>
        </Style>
        <Style Selector="Border.icon-chip.output">
            <Setter Property="Background" Value="#DBEAFE"/>
        </Style>
        <Style Selector="Border.icon-chip.discharge">
            <Setter Property="Background" Value="#FFEDD5"/>
        </Style>

        <!-- 흐름 화살표 배경 트랙 (연한 고정선) -->
        <Style Selector="Line.arrow-track">
            <Setter Property="Stroke" Value="#CBD5E1"/>
            <Setter Property="StrokeThickness" Value="4"/>
            <Setter Property="StrokeLineCap" Value="Round"/>
        </Style>

        <!-- 흐름 화살표 (점선이 흐르는 애니메이션, 레인 색상별) -->
        <Style Selector="Line.arrow-flow">
            <Setter Property="StrokeThickness" Value="4"/>
            <Setter Property="StrokeLineCap" Value="Round"/>
            <Setter Property="StrokeDashArray" Value="7,7"/>
            <Style.Animations>
                <Animation Duration="0:0:0.9" IterationCount="INFINITE">
                    <KeyFrame Cue="0%">
                        <Setter Property="StrokeDashOffset" Value="0"/>
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="StrokeDashOffset" Value="-28"/>
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <Style Selector="Line.arrow-flow.charge">
            <Setter Property="Stroke" Value="#15803D"/>
        </Style>
        <Style Selector="Line.arrow-flow.output">
            <Setter Property="Stroke" Value="#1D4ED8"/>
        </Style>
        <Style Selector="Line.arrow-flow.discharge">
            <Setter Property="Stroke" Value="#C2410C"/>
        </Style>

        <Style Selector="Polygon.arrow-head">
            <Setter Property="Points" Value="0,0 13,7 0,14"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="Polygon.arrow-head.charge">
            <Setter Property="Fill" Value="#15803D"/>
        </Style>
        <Style Selector="Polygon.arrow-head.output">
            <Setter Property="Fill" Value="#1D4ED8"/>
        </Style>
        <Style Selector="Polygon.arrow-head.discharge">
            <Setter Property="Fill" Value="#C2410C"/>
        </Style>

    </UserControl.Styles>

    <!--
        로고 행(Auto) + 버튼 행(*) 구조로, 버튼 행이 남은 공간을 전부 채웁니다.
        버튼 내부는 Viewbox로 감싸서 버튼이 커져도 내용이 비례해서 같이 커집니다.
    -->
    <Grid Background="#F1F5F9"
          RowDefinitions="Auto,40,*"
          Margin="48">

        <!-- 회사 로고 (EVKMC) : 상단을 꽉 채우도록 크게 -->
        <Image Grid.Row="0"
               Source="avares://MobileEssControl/Assets/evkmc-logo.png"
               Height="230"
               Stretch="Uniform"
               HorizontalAlignment="Center"/>

        <!-- 운전 모드 3개 : 남은 공간을 셋이 균등하게 채움 -->
        <Grid Grid.Row="2"
              ColumnDefinitions="*,*,*">

            <!-- 배터리 충전 : 계통 -> 인버터 -> 배터리 -->
            <Border Grid.Column="0" Classes="mode-shadow">
            <Button Classes="mode-card"
                    Command="{Binding ShowAutoChargeCommand}"
                    Background="#ECFDF5"
                    BorderBrush="#86EFAC">

                <Viewbox Stretch="Uniform">
                    <Grid Width="560" Height="420">

                        <TextBlock Classes="mode-title"
                                   Text="배터리 충전"
                                   Foreground="#15803D"/>

                        <Grid ColumnDefinitions="140,*,140,*,140"
                              Width="520"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center">

                            <!-- 계통 -->
                            <Border Grid.Column="0" Classes="icon-chip charge">
                                <Image Source="avares://MobileEssControl/Assets/free-pylon-power-14863517.png"
                                       Margin="14"
                                       Stretch="Uniform"/>
                            </Border>

                            <Grid Grid.Column="1" Height="32">
                                <Line Classes="arrow-track" StartPoint="6,16" EndPoint="37,16"/>
                                <Line Classes="arrow-flow charge" StartPoint="6,16" EndPoint="37,16"/>
                                <Polygon Classes="arrow-head charge"/>
                            </Grid>

                            <!-- 인버터 -->
                            <Border Grid.Column="2" Classes="icon-chip charge">
                                <Image Source="avares://MobileEssControl/Assets/free-icon-inverter-11622748.png"
                                       Margin="12"
                                       Stretch="Uniform"/>
                            </Border>

                            <Grid Grid.Column="3" Height="32">
                                <Line Classes="arrow-track" StartPoint="6,16" EndPoint="37,16"/>
                                <Line Classes="arrow-flow charge" StartPoint="6,16" EndPoint="37,16"/>
                                <Polygon Classes="arrow-head charge"/>
                            </Grid>

                            <!-- 배터리 -->
                            <Border Grid.Column="4" Classes="icon-chip charge">
                                <Image Source="avares://MobileEssControl/Assets/free-icon-full-battery-664886.png"
                                       Margin="18"
                                       Stretch="Uniform"/>
                            </Border>

                        </Grid>
                    </Grid>
                </Viewbox>
            </Button>
            </Border>

            <!-- 인버터 출력 : 배터리 -> 인버터 -> 출력 -->
            <Border Grid.Column="1" Classes="mode-shadow">
            <Button Classes="mode-card"
                    Command="{Binding ShowExternalOutputCommand}"
                    Background="#EFF6FF"
                    BorderBrush="#93C5FD">

                <Viewbox Stretch="Uniform">
                    <Grid Width="560" Height="420">

                        <TextBlock Classes="mode-title"
                                   Text="인버터 출력"
                                   Foreground="#1D4ED8"/>

                        <Grid ColumnDefinitions="140,*,140,*,140"
                              Width="520"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center">

                            <!-- 배터리 -->
                            <Border Grid.Column="0" Classes="icon-chip output">
                                <Image Source="avares://MobileEssControl/Assets/free-icon-full-battery-664886.png"
                                       Margin="18"
                                       Stretch="Uniform"/>
                            </Border>

                            <Grid Grid.Column="1" Height="32">
                                <Line Classes="arrow-track" StartPoint="6,16" EndPoint="37,16"/>
                                <Line Classes="arrow-flow output" StartPoint="6,16" EndPoint="37,16"/>
                                <Polygon Classes="arrow-head output"/>
                            </Grid>

                            <!-- 인버터 -->
                            <Border Grid.Column="2" Classes="icon-chip output">
                                <Image Source="avares://MobileEssControl/Assets/free-icon-inverter-11622748.png"
                                       Margin="12"
                                       Stretch="Uniform"/>
                            </Border>

                            <Grid Grid.Column="3" Height="32">
                                <Line Classes="arrow-track" StartPoint="6,16" EndPoint="37,16"/>
                                <Line Classes="arrow-flow output" StartPoint="6,16" EndPoint="37,16"/>
                                <Polygon Classes="arrow-head output"/>
                            </Grid>

                            <!-- 출력 -->
                            <Border Grid.Column="4" Classes="icon-chip output">
                                <Image Source="avares://MobileEssControl/Assets/free-icon-charging-8259923.png"
                                       Margin="14"
                                       Stretch="Uniform"/>
                            </Border>

                        </Grid>
                    </Grid>
                </Viewbox>
            </Button>
            </Border>

            <!-- 인버터 출력(계통) : 배터리 -> 인버터 -> 계통(송전탑) -->
            <Border Grid.Column="2" Classes="mode-shadow">
            <Button Classes="mode-card"
                    Command="{Binding ShowGridDischargeCommand}"
                    Background="#FFF7ED"
                    BorderBrush="#FDBA74">

                <Viewbox Stretch="Uniform">
                    <Grid Width="560" Height="420">

                        <TextBlock Classes="mode-title"
                                   Text="인버터 출력(계통)"
                                   Foreground="#C2410C"/>

                        <Grid ColumnDefinitions="140,*,140,*,140"
                              Width="520"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center">

                            <!-- 배터리 -->
                            <Border Grid.Column="0" Classes="icon-chip discharge">
                                <Image Source="avares://MobileEssControl/Assets/free-icon-full-battery-664886.png"
                                       Margin="18"
                                       Stretch="Uniform"/>
                            </Border>

                            <Grid Grid.Column="1" Height="32">
                                <Line Classes="arrow-track" StartPoint="6,16" EndPoint="37,16"/>
                                <Line Classes="arrow-flow discharge" StartPoint="6,16" EndPoint="37,16"/>
                                <Polygon Classes="arrow-head discharge"/>
                            </Grid>

                            <!-- 인버터 -->
                            <Border Grid.Column="2" Classes="icon-chip discharge">
                                <Image Source="avares://MobileEssControl/Assets/free-icon-inverter-11622748.png"
                                       Margin="12"
                                       Stretch="Uniform"/>
                            </Border>

                            <Grid Grid.Column="3" Height="32">
                                <Line Classes="arrow-track" StartPoint="6,16" EndPoint="37,16"/>
                                <Line Classes="arrow-flow discharge" StartPoint="6,16" EndPoint="37,16"/>
                                <Polygon Classes="arrow-head discharge"/>
                            </Grid>

                            <!-- 계통 (송전탑) -->
                            <Border Grid.Column="4" Classes="icon-chip discharge">
                                <Image Source="avares://MobileEssControl/Assets/free-pylon-power-14863517.png"
                                       Margin="14"
                                       Stretch="Uniform"/>
                            </Border>

                        </Grid>
                    </Grid>
                </Viewbox>
            </Button>
            </Border>

        </Grid>
    </Grid>
</UserControl>
