<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="MobileEssControl.Views.Admin.AdminView">

    <UserControl.Resources>
        <!-- EMS Bit Field 상세 행 -->
        <DataTemplate x:Key="AdminBitDetailTemplate">
            <Border Background="#FFFFFF"
                    BorderBrush="#E2E8F0"
                    BorderThickness="0,0,0,1"
                    Padding="12,8">
                <Grid ColumnDefinitions="*,230">
                    <TextBlock Text="{ReflectionBinding Name}"
                               TextWrapping="Wrap"
                               Foreground="#334155"/>
                    <TextBlock Grid.Column="1"
                               Text="{ReflectionBinding Value}"
                               TextWrapping="Wrap"
                               FontWeight="SemiBold"
                               Foreground="#0F172A"/>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- Pack / Inverter Bit Field 상세 비교 행 -->
        <DataTemplate x:Key="AdminComparisonBitDetailTemplate">
            <Border Background="#FFFFFF"
                    BorderBrush="#E2E8F0"
                    BorderThickness="0,0,0,1"
                    Padding="12,8">
                <Grid ColumnDefinitions="*,180,180">
                    <TextBlock Text="{ReflectionBinding Name}"
                               TextWrapping="Wrap"
                               Foreground="#334155"/>
                    <TextBlock Grid.Column="1"
                               Text="{ReflectionBinding LeftValue}"
                               TextWrapping="Wrap"
                               FontWeight="SemiBold"
                               Foreground="#0F172A"/>
                    <TextBlock Grid.Column="2"
                               Text="{ReflectionBinding RightValue}"
                               TextWrapping="Wrap"
                               FontWeight="SemiBold"
                               Foreground="#0F172A"/>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- 31000번대 EMS 전용 행 -->
        <DataTemplate x:Key="AdminStatusRowTemplate">
            <Border Background="White"
                    BorderBrush="#E2E8F0"
                    BorderThickness="0,0,0,1"
                    Padding="12,9">
                <Grid RowDefinitions="Auto,Auto"
                      ColumnDefinitions="120,*,60,200,180,92">
                    <TextBlock Text="{ReflectionBinding AbsoluteAddressText}"
                               FontFamily="Consolas"
                               Foreground="#475569"/>
                    <TextBlock Grid.Column="1"
                               Text="{ReflectionBinding Name}"
                               TextWrapping="Wrap"
                               Foreground="#0F172A"/>
                    <TextBlock Grid.Column="2"
                               Text="{ReflectionBinding Unit}"
                               HorizontalAlignment="Center"
                               Foreground="#64748B"/>
                    <TextBlock Grid.Column="3"
                               Text="{ReflectionBinding DisplayValue}"
                               TextWrapping="Wrap"
                               VerticalAlignment="Top"
                               FontWeight="SemiBold"
                               Foreground="#0F172A"/>
                    <TextBlock Grid.Column="4"
                               Text="{ReflectionBinding RawValue}"
                               TextWrapping="Wrap"
                               HorizontalAlignment="Right"
                               FontFamily="Consolas"
                               Foreground="#64748B"/>
                    <Button Grid.Column="5"
                            Content="{ReflectionBinding ExpandButtonText}"
                            Command="{ReflectionBinding ToggleExpandedCommand}"
                            IsVisible="{ReflectionBinding IsBitField}"
                            Padding="9,5"
                            Background="#EAF0F6"
                            Foreground="#334155"
                            FontSize="12"
                            HorizontalContentAlignment="Center"/>

                    <Border Grid.Row="1"
                            Grid.ColumnSpan="6"
                            IsVisible="{ReflectionBinding IsExpanded}"
                            Margin="0,12,0,0"
                            Background="#F8FAFC"
                            BorderBrush="#D7E0EA"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="10">
                        <Grid RowDefinitions="Auto,*">
                            <Grid ColumnDefinitions="*,230"
                                  Margin="2,0,2,6">
                                <TextBlock Text="세부 상태 항목"
                                           FontWeight="Bold"
                                           Foreground="#475569"/>
                                <TextBlock Grid.Column="1"
                                           Text="현재 상태"
                                           FontWeight="Bold"
                                           Foreground="#475569"/>
                            </Grid>
                            <ItemsControl Grid.Row="1"
                                          ItemsSource="{ReflectionBinding BitDetails}"
                                          ItemTemplate="{StaticResource AdminBitDetailTemplate}"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- Pack 1 / Pack 2, Inverter 1 / Inverter 2 비교 행 -->
        <DataTemplate x:Key="AdminComparisonRowTemplate">
            <Border Background="White"
                    BorderBrush="#E2E8F0"
                    BorderThickness="0,0,0,1"
                    Padding="12,9">
                <Grid RowDefinitions="Auto,Auto"
                      ColumnDefinitions="140,*,60,132,132,205,92">
                    <TextBlock Text="{ReflectionBinding AbsoluteAddressText}"
                               FontFamily="Consolas"
                               Foreground="#475569"/>
                    <TextBlock Grid.Column="1"
                               Text="{ReflectionBinding Name}"
                               TextWrapping="Wrap"
                               Foreground="#0F172A"/>
                    <TextBlock Grid.Column="2"
                               Text="{ReflectionBinding Unit}"
                               HorizontalAlignment="Center"
                               Foreground="#64748B"/>

                    <!-- Pack 1 / Inverter 1 값: 고정 폭 + 오른쪽 정렬로 소수점 위치를 맞춘다. -->
                    <TextBlock Grid.Column="3"
                               Text="{ReflectionBinding LeftDisplayValue}"
                               HorizontalAlignment="Right"
                               TextAlignment="Right"
                               VerticalAlignment="Center"
                               FontFamily="Consolas"
                               FontWeight="SemiBold"
                               Foreground="#0F172A"/>

                    <!-- Pack 2 / Inverter 2 값 -->
                    <TextBlock Grid.Column="4"
                               Text="{ReflectionBinding RightDisplayValue}"
                               HorizontalAlignment="Right"
                               TextAlignment="Right"
                               VerticalAlignment="Center"
                               FontFamily="Consolas"
                               FontWeight="SemiBold"
                               Foreground="#0F172A"/>

                    <TextBlock Grid.Column="5"
                               Text="{ReflectionBinding RawValue}"
                               TextWrapping="Wrap"
                               HorizontalAlignment="Right"
                               TextAlignment="Right"
                               FontFamily="Consolas"
                               Foreground="#64748B"/>
                    <Button Grid.Column="6"
                            Content="{ReflectionBinding ExpandButtonText}"
                            Command="{ReflectionBinding ToggleExpandedCommand}"
                            IsVisible="{ReflectionBinding IsBitField}"
                            Padding="9,5"
                            Background="#EAF0F6"
                            Foreground="#334155"
                            FontSize="12"
                            HorizontalContentAlignment="Center"/>

                    <Border Grid.Row="1"
                            Grid.ColumnSpan="7"
                            IsVisible="{ReflectionBinding IsExpanded}"
                            Margin="0,12,0,0"
                            Background="#F8FAFC"
                            BorderBrush="#D7E0EA"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="10">
                        <Grid RowDefinitions="Auto,*">
                            <Grid ColumnDefinitions="*,180,180"
                                  Margin="2,0,2,6">
                                <TextBlock Text="세부 상태 항목"
                                           FontWeight="Bold"
                                           Foreground="#475569"/>
                                <TextBlock Grid.Column="1"
                                           Text="{ReflectionBinding LeftCaption}"
                                           FontWeight="Bold"
                                           Foreground="#475569"/>
                                <TextBlock Grid.Column="2"
                                           Text="{ReflectionBinding RightCaption}"
                                           FontWeight="Bold"
                                           Foreground="#475569"/>
                            </Grid>
                            <ItemsControl Grid.Row="1"
                                          ItemsSource="{ReflectionBinding BitDetails}"
                                          ItemTemplate="{StaticResource AdminComparisonBitDetailTemplate}"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </DataTemplate>


        <!-- EEP Parameter 스타일 관리자 제어 행 -->
        <DataTemplate x:Key="AdminControlTableRowTemplate">
            <Border Background="White"
                    BorderBrush="#E2E8F0"
                    BorderThickness="0,0,0,1"
                    Padding="10,8">
                <Grid ColumnDefinitions="44,88,*,110,130,68,104,160"
                      ColumnSpacing="8">
                    <CheckBox IsChecked="{ReflectionBinding IsChecked, Mode=TwoWay}"
                              VerticalAlignment="Center"
                              HorizontalAlignment="Center"/>
                    <TextBlock Grid.Column="1"
                               Text="{ReflectionBinding AddressText}"
                               FontFamily="Consolas"
                               VerticalAlignment="Center"
                               Foreground="#475569"/>
                    <StackPanel Grid.Column="2" Spacing="2">
                        <TextBlock Text="{ReflectionBinding ItemName}"
                                   TextWrapping="Wrap"
                                   Foreground="#0F172A"/>
                        <TextBlock Text="{ReflectionBinding Remark}"
                                   TextWrapping="Wrap"
                                   FontSize="11"
                                   Foreground="#64748B"/>
                    </StackPanel>
                    <TextBlock Grid.Column="3"
                               Text="{ReflectionBinding RValue}"
                               FontFamily="Consolas"
                               FontWeight="SemiBold"
                               TextAlignment="Right"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               Foreground="#0F172A"/>
                    <TextBox Grid.Column="4"
                             Text="{ReflectionBinding WValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             IsEnabled="{ReflectionBinding IsWriteEnabled}"
                             Watermark="Write 값"
                             FontFamily="Consolas"
                             HorizontalContentAlignment="Right"
                             VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="5"
                               Text="{ReflectionBinding Unit}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Foreground="#64748B"/>
                    <TextBlock Grid.Column="6"
                               Text="{ReflectionBinding FunctionText}"
                               FontFamily="Consolas"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Foreground="#475569"/>
                    <TextBlock Grid.Column="7"
                               Text="{ReflectionBinding RawValue}"
                               FontFamily="Consolas"
                               TextAlignment="Right"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               Foreground="#64748B"/>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Background="#F3F6FB"
          RowDefinitions="Auto,*,210">

        <Border Margin="24,22,24,14"
                Background="White"
                BorderBrush="#D7E0EA"
                BorderThickness="1"
                CornerRadius="16"
                Padding="22,16">

            <Grid ColumnDefinitions="*,Auto"
                  RowDefinitions="Auto,Auto">

                <StackPanel Spacing="5">
                    <TextBlock Text="EMS 상태 및 제어"
                               FontSize="24"
                               FontWeight="Bold"
                               Foreground="#0F172A"/>

                </StackPanel>

                <StackPanel Grid.Column="1"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Spacing="4">
                    <TextBlock Text="{ReflectionBinding CommunicationText}"
                               HorizontalAlignment="Right"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="#0F766E"/>
                    <TextBlock Text="{ReflectionBinding LastUpdatedText}"
                               HorizontalAlignment="Right"
                               FontSize="12"
                               Foreground="#64748B"/>
                </StackPanel>

                <Grid Grid.Row="1"
                      Grid.ColumnSpan="2"
                      Margin="0,12,0,0"
                      ColumnDefinitions="*,Auto">

                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Spacing="8">
                        <Button Content="연결"
                                Command="{ReflectionBinding ConnectCommand}"
                                MinWidth="94"
                                Height="42"
                                Padding="16,8"
                                Background="#2563EB"
                                Foreground="White"
                                FontSize="16"
                                FontWeight="SemiBold"
                                HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center"/>

                        <Button Content="연결 해제"
                                Command="{ReflectionBinding DisconnectCommand}"
                                MinWidth="110"
                                Height="42"
                                Padding="16,8"
                                Background="#64748B"
                                Foreground="White"
                                FontSize="16"
                                FontWeight="SemiBold"
                                HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center"/>
                    </StackPanel>

                    <Button Grid.Column="1"
                            Content="← 메인화면"
                            Command="{ReflectionBinding ExitAdminCommand}"
                            Padding="16,8"
                            Background="#E2E8F0"
                            Foreground="#0F172A"/>
                </Grid>
            </Grid>
        </Border>

        <TabControl Grid.Row="1"
                    Margin="24,0,24,22"
                    Background="White">

            <!-- 31000번대: EMS와 System/Pack 상태 비트 -->
            <TabItem>
                <TabItem.Header>
                    <TextBlock Text="EMS"
                               Foreground="#334155"
                               FontSize="22"
                               Margin="8,0"/>
                </TabItem.Header>

                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Auto">
                    <StackPanel Margin="18" Spacing="8">
                        <TextBlock Text="EMS  · 31001 ~ 31057"
                                   FontSize="17"
                                   FontWeight="SemiBold"
                                   Foreground="#0F172A"/>
                        <TextBlock Text="상태·알람 Bit Field는 기본 접힘 상태입니다. + 상세 버튼을 누르면 세부 항목을 한 줄씩 확인할 수 있습니다."
                                   FontSize="12"
                                   Foreground="#64748B"/>

                        <Border Background="#EAF0F6" Padding="12,9" CornerRadius="7">
                            <Grid ColumnDefinitions="120,*,60,200,180,92">
                                <TextBlock Text="Address" FontWeight="Bold" Foreground="#334155"/>
                                <TextBlock Grid.Column="1" Text="Name" FontWeight="Bold" Foreground="#334155"/>
                                <TextBlock Grid.Column="2" Text="Unit" HorizontalAlignment="Center" FontWeight="Bold" Foreground="#334155"/>
                                <TextBlock Grid.Column="3" Text="Value" FontWeight="Bold" Foreground="#334155"/>
                                <TextBlock Grid.Column="4" Text="Raw Data" HorizontalAlignment="Right" FontWeight="Bold" Foreground="#334155"/>
                            </Grid>
                        </Border>

                        <ItemsControl ItemsSource="{ReflectionBinding SystemRows}"
                                      ItemTemplate="{StaticResource AdminStatusRowTemplate}"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

          


           


            <!-- Pack 1과 Pack 2는 합계 없이 같은 줄에서 비교 -->
            <TabItem>
                <TabItem.Header>
                    <TextBlock Text="배터리"
                               Foreground="#334155"
                               FontSize="22"
                               Margin="8,0"/>
                </TabItem.Header>

                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Auto">
                    <StackPanel Margin="18" Spacing="8">
                        <TextBlock Text="Battery Pack 비교 · Pack 1 (32001 ~ 32024) / Pack 2 (33001 ~ 33024)"
                                   FontSize="17"
                                   FontWeight="SemiBold"
                                   Foreground="#0F172A"/>
                        <TextBlock Text="합산하지 않습니다. Bit Field는 + 상세 버튼을 누르면 Pack 1과 Pack 2 값을 각각 분리해서 표시합니다."
                                   FontSize="12"
                                   Foreground="#64748B"/>

                        <Border Background="#EAF0F6" Padding="12,9" CornerRadius="7">
                            <Grid ColumnDefinitions="140,*,60,132,132,205,92">
                                <TextBlock Text="Address (P1 / P2)" FontWeight="Bold" Foreground="#334155"/>
                                <TextBlock Grid.Column="1" Text="Name" FontWeight="Bold" Foreground="#334155"/>
                                <TextBlock Grid.Column="2" Text="Unit" HorizontalAlignment="Center" FontWeight="Bold" Foreground="#334155"/>
                                <TextBlock Grid.Column="3" Text="Pack 1 Value" HorizontalAlignment="Right" FontWeight="Bold" Foreground="#334155"/>
                                <TextBlock Grid.Column="4" Text="Pack 2 Value" HorizontalAlignment="Right" FontWeight="Bold" Foreground="#334155"/>
                                <TextBlock Grid.Column="5" Text="Raw Data (P1 / P2)" HorizontalAlignment="Right" FontWeight="Bold" Foreground="#334155"/>
                            </Grid>
                        </Border>

                        <ItemsControl ItemsSource="{ReflectionBinding BatteryRows}"
                                      ItemTemplate="{StaticResource AdminComparisonRowTemplate}"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Inverter 1과 Inverter 2는 합계 없이 같은 줄에서 비교 -->
            <TabItem>
                <TabItem.Header>
                    <TextBlock Text="인버터"
                               Foreground="#334155"
                               FontSize="22"
                               Margin="8,0"/>
                </TabItem.Header>

                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Auto">
                    <StackPanel Margin="18" Spacing="8">
                        <TextBlock Text="Inverter 비교 · Inverter 1 (40001 ~ 40033) / Inverter 2 (41001 ~ 41033)"
                                   FontSize="17"
                                   FontWeight="SemiBold"
                                   Foreground="#0F172A"/>
                        <TextBlock Text="합산하지 않습니다. AlarmStatus는 + 상세 버튼을 누르면 각 상태를 한 줄씩, Inverter 1 / Inverter 2 값으로 분리해 표시합니다."
                                   FontSize="12"
                                   Foreground="#64748B"/>

                        <Border Background="#EAF0F6" Padding="12,9" CornerRadius="7">
                            <Grid ColumnDefinitions="140,*,60,132,132,205,92">
                                <TextBlock Text="Address (INV1 / INV2)" FontWeight="Bold" Foreground="#334155"/>
                                <TextBlock Grid.Column="1" Text="Name" FontWeight="Bold" Foreground="#334155"/>
                                <TextBlock Grid.Column="2" Text="Unit" HorizontalAlignment="Center" FontWeight="Bold" Foreground="#334155"/>
                                <TextBlock Grid.Column="3" Text="INV1 Value" HorizontalAlignment="Right" FontWeight="Bold" Foreground="#334155"/>
                                <TextBlock Grid.Column="4" Text="INV2 Value" HorizontalAlignment="Right" FontWeight="Bold" Foreground="#334155"/>
                                <TextBlock Grid.Column="5" Text="Raw Data (INV1 / INV2)" HorizontalAlignment="Right" FontWeight="Bold" Foreground="#334155"/>
                            </Grid>
                        </Border>

                        <ItemsControl ItemsSource="{ReflectionBinding InverterRows}"
                                      ItemTemplate="{StaticResource AdminComparisonRowTemplate}"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

              <!-- EEP Parameter 스타일: ESS 제어 테이블 -->
            <TabItem>
                <TabItem.Header>
                    <TextBlock Text="EMS 제어"
                               Foreground="#334155"
                               FontSize="22"
                               Margin="8,0"/>
                </TabItem.Header>

               <Grid RowDefinitions="Auto,*"
      Margin="18">

    <!-- 위쪽 고정 영역: 제목 + 버튼 -->
    <StackPanel Grid.Row="0"
                Spacing="12">

        <StackPanel Spacing="4">
            <TextBlock Text="EMS Control Table · 30001 ~ 30012"
                       FontSize="18"
                       FontWeight="Bold"
                       Foreground="#0F172A"/>
            <TextBlock Text="EEP Parameter 화면처럼 Read 값은 R.Value에 표시하고, 사용자가 체크한 행의 W.Value만 Write합니다. Read는 0x03, Write는 0x06을 사용합니다."
                       TextWrapping="Wrap"
                       FontSize="12"
                       Foreground="#64748B"/>
        </StackPanel>

        <Border Background="#EFF6FF"
                BorderBrush="#BFDBFE"
                BorderThickness="1"
                CornerRadius="10"
                Padding="14">
            <Grid ColumnDefinitions="*,Auto"
                  ColumnSpacing="10">
                <TextBlock Text="{ReflectionBinding EssControlTableStatusText}"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           Foreground="#1E3A8A"/>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="8">
                    <Button Content="Read All"
                            Command="{ReflectionBinding ReadAllEssControlTableCommand}"
                            Padding="14,8"
                            Background="#2563EB"
                            Foreground="White"/>
                    <Button Content="Read Checked"
                            Command="{ReflectionBinding ReadCheckedEssControlTableCommand}"
                            Padding="14,8"
                            Background="#475569"
                            Foreground="White"/>
                    <Button Content="Write Checked"
                            Command="{ReflectionBinding WriteCheckedEssControlTableCommand}"
                            Padding="14,8"
                            Background="#DC2626"
                            Foreground="White"/>
                    <Button Content="W.Value Clear"
                            Command="{ReflectionBinding ClearEssControlTableWValuesCommand}"
                            Padding="14,8"/>
                    <Button Content="All Check"
                            Command="{ReflectionBinding CheckAllEssControlTableCommand}"
                            Padding="14,8"/>
                    <Button Content="All UnCheck"
                            Command="{ReflectionBinding UncheckAllEssControlTableCommand}"
                            Padding="14,8"/>
                </StackPanel>
            </Grid>
        </Border>
    </StackPanel>

    <!-- 아래쪽만 스크롤 -->
    <ScrollViewer Grid.Row="1"
                  Margin="0,12,0,0"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Auto">
        <StackPanel Spacing="0">

            <Border Background="#EAF0F6"
                    Padding="10,9"
                    CornerRadius="7">
                <Grid ColumnDefinitions="44,88,*,110,130,68,104,160"
                      ColumnSpacing="8">
                    <TextBlock Text="선택" FontWeight="Bold" HorizontalAlignment="Center" Foreground="#334155"/>
                    <TextBlock Grid.Column="1" Text="Address" FontWeight="Bold" Foreground="#334155"/>
                    <TextBlock Grid.Column="2" Text="Item" FontWeight="Bold" Foreground="#334155"/>
                    <TextBlock Grid.Column="3" Text="R.Value" FontWeight="Bold" HorizontalAlignment="Right" Foreground="#334155"/>
                    <TextBlock Grid.Column="4" Text="W.Value" FontWeight="Bold" HorizontalAlignment="Center" Foreground="#334155"/>
                    <TextBlock Grid.Column="5" Text="Unit" FontWeight="Bold" HorizontalAlignment="Center" Foreground="#334155"/>
                    <TextBlock Grid.Column="6" Text="Function" FontWeight="Bold" HorizontalAlignment="Center" Foreground="#334155"/>
                    <TextBlock Grid.Column="7" Text="Raw" FontWeight="Bold" HorizontalAlignment="Right" Foreground="#334155"/>
                </Grid>
            </Border>

            <ItemsControl ItemsSource="{ReflectionBinding EssControlTableRows}"
                          ItemTemplate="{StaticResource AdminControlTableRowTemplate}"/>
        </StackPanel>
    </ScrollViewer>
</Grid>
            </TabItem>

             <!-- EEP Parameter 스타일: 인버터 제어 테이블 -->
            <TabItem>
                <TabItem.Header>
                    <TextBlock Text="인버터 제어"
                               Foreground="#334155"
                               FontSize="22"
                               Margin="8,0"/>
                </TabItem.Header>

               <Grid RowDefinitions="Auto,*"
      Margin="18">

    <!-- 위쪽 고정 영역: 제목 + 버튼 -->
    <StackPanel Grid.Row="0"
                Spacing="12">

        <StackPanel Spacing="4">
            <TextBlock Text="Inverter Control  · 40024 ~ 40063 / 41024 ~ 41063"
                       FontSize="18"
                       FontWeight="Bold"
                       Foreground="#0F172A"/>
            <TextBlock Text="체크한 행만 선택 Read/Write할 수 있습니다. Read는 0x03, Write는 0x06을 사용합니다. 모드 변경은 실제 인버터 정지 상태를 확인한 뒤 사용하세요."
                       TextWrapping="Wrap"
                       FontSize="12"
                       Foreground="#64748B"/>
        </StackPanel>

        <Border Background="#EFF6FF"
                BorderBrush="#BFDBFE"
                BorderThickness="1"
                CornerRadius="10"
                Padding="14">
            <Grid ColumnDefinitions="*,Auto"
                  ColumnSpacing="10">
                <TextBlock Text="{ReflectionBinding InverterControlTableStatusText}"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           Foreground="#1E3A8A"/>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="8">
                    <Button Content="Read All"
                            Command="{ReflectionBinding ReadAllInverterControlTableCommand}"
                            Padding="14,8"
                            Background="#2563EB"
                            Foreground="White"/>
                    <Button Content="Read Checked"
                            Command="{ReflectionBinding ReadCheckedInverterControlTableCommand}"
                            Padding="14,8"
                            Background="#475569"
                            Foreground="White"/>
                    <Button Content="Write Checked"
                            Command="{ReflectionBinding WriteCheckedInverterControlTableCommand}"
                            Padding="14,8"
                            Background="#DC2626"
                            Foreground="White"/>
                    <Button Content="W.Value Clear"
                            Command="{ReflectionBinding ClearInverterControlTableWValuesCommand}"
                            Padding="14,8"/>
                    <Button Content="All Check"
                            Command="{ReflectionBinding CheckAllInverterControlTableCommand}"
                            Padding="14,8"/>
                    <Button Content="All UnCheck"
                            Command="{ReflectionBinding UncheckAllInverterControlTableCommand}"
                            Padding="14,8"/>
                </StackPanel>
            </Grid>
        </Border>
    </StackPanel>

    <!-- 아래쪽만 스크롤 -->
    <ScrollViewer Grid.Row="1"
                  Margin="0,12,0,0"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Auto">
        <StackPanel Spacing="0">

            <Border Background="#EAF0F6"
                    Padding="10,9"
                    CornerRadius="7">
                <Grid ColumnDefinitions="44,88,*,110,130,68,104,160"
                      ColumnSpacing="8">
                    <TextBlock Text="선택" FontWeight="Bold" HorizontalAlignment="Center" Foreground="#334155"/>
                    <TextBlock Grid.Column="1" Text="Address" FontWeight="Bold" Foreground="#334155"/>
                    <TextBlock Grid.Column="2" Text="Item" FontWeight="Bold" Foreground="#334155"/>
                    <TextBlock Grid.Column="3" Text="R.Value" FontWeight="Bold" HorizontalAlignment="Right" Foreground="#334155"/>
                    <TextBlock Grid.Column="4" Text="W.Value" FontWeight="Bold" HorizontalAlignment="Center" Foreground="#334155"/>
                    <TextBlock Grid.Column="5" Text="Unit" FontWeight="Bold" HorizontalAlignment="Center" Foreground="#334155"/>
                    <TextBlock Grid.Column="6" Text="Function" FontWeight="Bold" HorizontalAlignment="Center" Foreground="#334155"/>
                    <TextBlock Grid.Column="7" Text="Raw" FontWeight="Bold" HorizontalAlignment="Right" Foreground="#334155"/>
                </Grid>
            </Border>

            <ItemsControl ItemsSource="{ReflectionBinding InverterControlTableRows}"
                          ItemTemplate="{StaticResource AdminControlTableRowTemplate}"/>
        </StackPanel>
    </ScrollViewer>
</Grid>
            </TabItem>
        </TabControl>

        <Border Grid.Row="2"
                Margin="24,0,24,22"
                Background="White"
                BorderBrush="#D7E0EA"
                BorderThickness="1"
                CornerRadius="14"
                Padding="14">
            <Grid RowDefinitions="Auto,*">
                <Grid ColumnDefinitions="*,Auto"
                      Margin="0,0,0,10">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="통신 로그"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   Foreground="#0F172A"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="COM 연결 · Modbus 요청 · 응답 · 오류 확인"
                                   FontSize="12"
                                   Foreground="#64748B"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <Button Grid.Column="1"
                            Content="로그 지우기"
                            Command="{ReflectionBinding ClearLogCommand}"
                            Padding="14,7"
                            Background="#E2E8F0"
                            Foreground="#0F172A"/>
                </Grid>

                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Auto"
                              Background="#0F172A">
                    <TextBox Text="{ReflectionBinding CommunicationLogText}"
                             IsReadOnly="True"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             Background="#0F172A"
                             Foreground="#E2E8F0"
                             BorderThickness="0"
                             Padding="12"
                             FontFamily="Consolas"
                             FontSize="13"/>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
