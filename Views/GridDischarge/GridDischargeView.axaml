<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MobileEssControl.ViewModels.GridDischarge"
             x:DataType="vm:GridDischargeViewModel"
             x:Class="MobileEssControl.Views.GridDischarge.GridDischargeView">

    <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Disabled">

        <StackPanel Spacing="10">

            <!-- 화면 제목 -->
            <TextBlock Text="계통 방전"
                       Foreground="#0F172A"
                       FontSize="30"
                       FontWeight="Bold"/>

            <!-- 현재 상태 카드 -->
            <Grid ColumnDefinitions="0.8*,1*,1.15*,1.5*"
                  ColumnSpacing="14">

                <Border Grid.Column="0"
                        Background="White"
                        BorderBrush="#E2E8F0"
                        BorderThickness="1"
                        CornerRadius="18"
                        Padding="18">

                    <StackPanel Spacing="6">
                        <TextBlock Text="현재 SOC"
                                   Foreground="#64748B"
                                   FontSize="14"
                                   FontWeight="Bold"/>

                        <TextBlock Text="{Binding CurrentSocText}"
                                   Foreground="#16A34A"
                                   FontSize="30"
                                   FontWeight="Bold"/>

                        <TextBlock Text="31017 System SOC"
                                   Foreground="#94A3B8"
                                   FontSize="12"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1"
                        Background="White"
                        BorderBrush="#E2E8F0"
                        BorderThickness="1"
                        CornerRadius="18"
                        Padding="18">

                    <StackPanel Spacing="6">
                        <TextBlock Text="현재 방전전력"
                                   Foreground="#64748B"
                                   FontSize="14"
                                   FontWeight="Bold"/>

                        <TextBlock Text="{Binding CurrentDischargePowerText}"
                                   Foreground="#2563EB"
                                   FontSize="30"
                                   FontWeight="Bold"/>

                  
                    </StackPanel>
                </Border>

                <Border Grid.Column="2"
                        Background="White"
                        BorderBrush="#E2E8F0"
                        BorderThickness="1"
                        CornerRadius="18"
                        Padding="18">

                    <StackPanel Spacing="6">
                        <TextBlock Text="시스템 전압 / 전류"
                                   Foreground="#64748B"
                                   FontSize="14"
                                   FontWeight="Bold"/>

                        <TextBlock Text="{Binding SystemVoltageCurrentText}"
                                   Foreground="#7E22CE"
                                   FontSize="30"
                                   FontWeight="Bold"/>

                    
                    </StackPanel>
                </Border>

                <Border Grid.Column="3"
                        Background="White"
                        BorderBrush="#E2E8F0"
                        BorderThickness="1"
                        CornerRadius="18"
                        Padding="14">

                    <StackPanel Spacing="5">
                        <TextBlock Text="인버터 3상 대표값"
                                   Foreground="#64748B"
                                   FontSize="14"
                                   FontWeight="Bold"/>

                        <Grid RowDefinitions="Auto,Auto,Auto"
                              ColumnDefinitions="Auto,*"
                              RowSpacing="3"
                              ColumnSpacing="10">

                            <TextBlock Grid.Row="0"
                                       Grid.Column="0"
                                       Text="전압"
                                       Foreground="#94A3B8"
                                       FontSize="12"
                                       FontWeight="Bold"
                                       VerticalAlignment="Center"/>

                            <TextBlock Grid.Row="0"
                                       Grid.Column="1"
                                       Text="{Binding ThreePhaseVoltageText}"
                                       Foreground="#0F766E"
                                       FontSize="17"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Right"/>

                            <TextBlock Grid.Row="1"
                                       Grid.Column="0"
                                       Text="전류"
                                       Foreground="#94A3B8"
                                       FontSize="12"
                                       FontWeight="Bold"
                                       VerticalAlignment="Center"/>

                            <TextBlock Grid.Row="1"
                                       Grid.Column="1"
                                       Text="{Binding ThreePhaseCurrentText}"
                                       Foreground="#0369A1"
                                       FontSize="17"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Right"/>

                            <TextBlock Grid.Row="2"
                                       Grid.Column="0"
                                       Text="주파수"
                                       Foreground="#94A3B8"
                                       FontSize="12"
                                       FontWeight="Bold"
                                       VerticalAlignment="Center"/>

                            <TextBlock Grid.Row="2"
                                       Grid.Column="1"
                                       Text="{Binding GridFrequencyText}"
                                       Foreground="#7E22CE"
                                       FontSize="17"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Right"/>
                        </Grid>

                        <TextBlock Text="AB·BC·CA / A·B·C"
                                   Foreground="#CBD5E1"
                                   FontSize="10"
                                   HorizontalAlignment="Right"/>
                    </StackPanel>
                </Border>
            </Grid>

            <Grid ColumnDefinitions="1.15*,1*"
                  ColumnSpacing="16">

                <!-- 계통 방전 흐름 -->
                <Border Grid.Column="0"
                        Background="White"
                        BorderBrush="#E2E8F0"
                        BorderThickness="1"
                        CornerRadius="18"
                        Padding="18">

                    <StackPanel Spacing="12">

                        <TextBlock Text="계통 방전 흐름"
                                   Foreground="#0F172A"
                                   FontSize="21"
                                   FontWeight="Bold"/>

                        <Border Background="#F8FAFC"
                                BorderBrush="#E2E8F0"
                                BorderThickness="1"
                                CornerRadius="18"
                                Padding="14">

                            <Grid ColumnDefinitions="*,90,*,90,*"
                                  ColumnSpacing="10">

                                <!-- 배터리 -->
                                <Border Grid.Column="0"
                                        Background="{Binding BatteryBackground}"
                                        BorderBrush="{Binding BatteryBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="16"
                                        Padding="12"
                                        MinHeight="135">

                                    <StackPanel Spacing="12"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center">

                                        <Border Width="92"
                                                Height="58"
                                                CornerRadius="14"
                                                Background="White"
                                                BorderBrush="{Binding BatteryBorderBrush}"
                                                BorderThickness="2">

                                            <Grid ColumnDefinitions="*,Auto"
                                                  Margin="8,8,4,8">

                                                <Border Grid.Column="0"
                                                        Background="{Binding BatteryBrush}"
                                                        CornerRadius="8"/>

                                                <Border Grid.Column="1"
                                                        Width="8"
                                                        Height="22"
                                                        CornerRadius="4"
                                                        Background="{Binding BatteryBrush}"
                                                        VerticalAlignment="Center"
                                                        Margin="4,0,0,0"/>
                                            </Grid>
                                        </Border>

                                        <TextBlock Text="배터리"
                                                   Foreground="#0F172A"
                                                   FontSize="20"
                                                   FontWeight="Bold"/>

                                        <TextBlock Text="{Binding CurrentSocText}"
                                                   Foreground="{Binding BatteryBrush}"
                                                   FontSize="15"
                                                   FontWeight="Bold"/>
                                    </StackPanel>
                                </Border>

                                <!-- DC 방향 -->
                                <Grid Grid.Column="1"
                                      Opacity="{Binding DcArrowOpacity}"
                                      VerticalAlignment="Center">

                                    <Line StartPoint="4,0"
                                          EndPoint="74,0"
                                          Stroke="{Binding FlowBrush}"
                                          StrokeThickness="5"/>

                                    <Path Data="M 78 0 L 60 -13 L 60 13 Z"
                                          Fill="{Binding FlowBrush}"/>

                                    <TextBlock Text="DC"
                                               Foreground="{Binding FlowBrush}"
                                               FontSize="12"
                                               FontWeight="Bold"
                                               HorizontalAlignment="Center"
                                               Margin="0,18,0,0"/>
                                </Grid>

                                <!-- 인버터 -->
                                <Border Grid.Column="2"
                                        Background="{Binding FlowBackground}"
                                        BorderBrush="{Binding FlowBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="16"
                                        Padding="12"
                                        MinHeight="135">

                                    <StackPanel Spacing="12"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center">

                                        <Border Width="74"
                                                Height="74"
                                                CornerRadius="20"
                                                Background="White"
                                                BorderBrush="{Binding FlowBorderBrush}"
                                                BorderThickness="2">

                                            <TextBlock Text="INV"
                                                       Foreground="{Binding FlowBrush}"
                                                       FontSize="22"
                                                       FontWeight="Bold"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                        </Border>

                                        <TextBlock Text="인버터"
                                                   Foreground="#0F172A"
                                                   FontSize="20"
                                                   FontWeight="Bold"/>

                                        <TextBlock Text="{Binding CurrentDischargePowerText}"
                                                   Foreground="{Binding FlowBrush}"
                                                   FontSize="15"
                                                   FontWeight="Bold"/>
                                    </StackPanel>
                                </Border>

                                <!-- AC 방향 -->
                                <Grid Grid.Column="3"
                                      Opacity="{Binding AcArrowOpacity}"
                                      VerticalAlignment="Center">

                                    <Line StartPoint="4,0"
                                          EndPoint="74,0"
                                          Stroke="{Binding FlowBrush}"
                                          StrokeThickness="5"/>

                                    <Path Data="M 78 0 L 60 -13 L 60 13 Z"
                                          Fill="{Binding FlowBrush}"/>

                                    <TextBlock Text="AC"
                                               Foreground="{Binding FlowBrush}"
                                               FontSize="12"
                                               FontWeight="Bold"
                                               HorizontalAlignment="Center"
                                               Margin="0,18,0,0"/>
                                </Grid>

                                <!-- 계통 -->
                                <Border Grid.Column="4"
                                        Background="{Binding FlowBackground}"
                                        BorderBrush="{Binding FlowBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="16"
                                        Padding="12"
                                        MinHeight="135">

                                    <StackPanel Spacing="12"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center">

                                        <Border Width="74"
                                                Height="74"
                                                CornerRadius="37"
                                                Background="White"
                                                BorderBrush="{Binding FlowBorderBrush}"
                                                BorderThickness="2">

                                            <TextBlock Text="GRID"
                                                       Foreground="{Binding FlowBrush}"
                                                       FontSize="17"
                                                       FontWeight="Bold"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                        </Border>

                                        <TextBlock Text="계통"
                                                   Foreground="#0F172A"
                                                   FontSize="20"
                                                   FontWeight="Bold"/>

                                        <TextBlock Text="AC 380V"
                                                   Foreground="#64748B"
                                                   FontSize="13"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>

                        <Border Background="#FFF7ED"
                                BorderBrush="#FED7AA"
                                BorderThickness="1"
                                CornerRadius="16"
                                Padding="16">

                            <TextBlock Text="계통 연계 조건, 차단기 상태 및 N상 절체 상태를 확인한 후 운전하세요."
                                       Foreground="#9A3412"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap"/>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- 방전 설정 -->
                <Border Grid.Column="1"
                        Background="White"
                        BorderBrush="#E2E8F0"
                        BorderThickness="1"
                        CornerRadius="16"
                        Padding="18">

                    <StackPanel Spacing="14">

                        <StackPanel Spacing="4">
                            <TextBlock Text="방전 설정"
                                       FontSize="24"
                                       FontWeight="Bold"
                                       Foreground="#0F172A"/>

                        </StackPanel>

                        <!-- 방전전력 설정 -->
                        <Border IsEnabled="{Binding CanEditSettings}"
                                Background="#F8FAFC"
                                BorderBrush="#E2E8F0"
                                BorderThickness="1"
                                CornerRadius="18"
                                Padding="14">

                            <StackPanel Spacing="10">

                                <TextBlock Text="방전전력"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="#64748B"
                                           HorizontalAlignment="Center"/>

                                <Border Background="#EFF6FF"
                                        BorderBrush="#BFDBFE"
                                        BorderThickness="1"
                                        CornerRadius="18"
                                        Padding="10">

                                    <StackPanel Spacing="6"
                                                HorizontalAlignment="Center">

                                        <TextBlock Text="{Binding DischargePowerText}"
                                                   FontSize="42"
                                                   FontWeight="Bold"
                                                   Foreground="#2563EB"
                                                   HorizontalAlignment="Center"/>

                                      
                                    </StackPanel>
                                </Border>

                                <!-- 터치 슬라이더 -->
                                <Grid RowDefinitions="Auto,Auto"
                                      RowSpacing="8">

                                    <Slider Grid.Row="0"
                                            Minimum="1"
                                            Maximum="40"
                                            Value="{Binding DischargePowerKw, Mode=TwoWay}"
                                            Height="42"
                                            MinHeight="42"
                                            TickFrequency="1"
                                            IsSnapToTickEnabled="True"
                                            HorizontalAlignment="Stretch"
                                            VerticalAlignment="Center"/>

                                    <Grid Grid.Row="1"
                                          ColumnDefinitions="Auto,*,Auto">

                                        <TextBlock Grid.Column="0"
                                                   Text="1 kW"
                                                   Foreground="#94A3B8"
                                                   FontSize="12"
                                                   FontWeight="Bold"/>

                                        <TextBlock Grid.Column="2"
                                                   Text="40 kW"
                                                   Foreground="#94A3B8"
                                                   FontSize="12"
                                                   FontWeight="Bold"/>
                                    </Grid>
                                </Grid>

                                <!-- 큰 - / + 버튼 -->
                                <Grid ColumnDefinitions="*,*"
                                      ColumnSpacing="14">

                                    <Button Grid.Column="0"
                                            Content="−"
                                            Height="48"
                                            FontSize="23"
                                            FontWeight="Bold"
                                            Background="#F1F5F9"
                                            Foreground="#0F172A"
                                            BorderBrush="#CBD5E1"
                                            CornerRadius="22"
                                            Command="{Binding DecreaseDischargePowerCommand}"/>

                                    <Button Grid.Column="1"
                                            Content="+"
                                            Height="48"
                                            FontSize="23"
                                            FontWeight="Bold"
                                            Background="#EFF6FF"
                                            Foreground="#1D4ED8"
                                            BorderBrush="#BFDBFE"
                                            CornerRadius="22"
                                            Command="{Binding IncreaseDischargePowerCommand}"/>
                                </Grid>

                                <TextBlock Text="EMS 30011"
                                           FontSize="11"
                                           Foreground="#CBD5E1"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- 최저 SOC 설정 -->
                        <Border IsEnabled="{Binding CanEditSettings}"
                                Background="#F8FAFC"
                                BorderBrush="#E2E8F0"
                                BorderThickness="1"
                                CornerRadius="18"
                                Padding="14">

                            <StackPanel Spacing="10">

                                <TextBlock Text="최저 SOC"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="#64748B"
                                           HorizontalAlignment="Center"/>

                                <Border Background="#ECFDF5"
                                        BorderBrush="#BBF7D0"
                                        BorderThickness="1"
                                        CornerRadius="18"
                                        Padding="10">

                                    <StackPanel Spacing="6"
                                                HorizontalAlignment="Center">

                                        <TextBlock Text="{Binding MinSocText}"
                                                   FontSize="44"
                                                   FontWeight="Bold"
                                                   Foreground="#16A34A"
                                                   HorizontalAlignment="Center"/>

                                     
                                    </StackPanel>
                                </Border>

                                <!-- 터치 슬라이더 -->
                                <Grid RowDefinitions="Auto,Auto"
                                      RowSpacing="8">

                                    <Slider Grid.Row="0"
                                            Minimum="10"
                                            Maximum="90"
                                            Value="{Binding MinSoc, Mode=TwoWay}"
                                            Height="42"
                                            MinHeight="42"
                                            TickFrequency="5"
                                            IsSnapToTickEnabled="True"
                                            HorizontalAlignment="Stretch"
                                            VerticalAlignment="Center"/>

                                    <Grid Grid.Row="1"
                                          ColumnDefinitions="Auto,*,Auto">

                                        <TextBlock Grid.Column="0"
                                                   Text="10%"
                                                   Foreground="#94A3B8"
                                                   FontSize="12"
                                                   FontWeight="Bold"/>

                                        <TextBlock Grid.Column="2"
                                                   Text="90%"
                                                   Foreground="#94A3B8"
                                                   FontSize="12"
                                                   FontWeight="Bold"/>
                                    </Grid>
                                </Grid>

                                <!-- 큰 - / + 버튼 -->
                                <Grid ColumnDefinitions="*,*"
                                      ColumnSpacing="22">

                                    <Button Grid.Column="0"
                                            Content="−"
                                            Height="48"
                                            FontSize="23"
                                            FontWeight="Bold"
                                            Background="#F1F5F9"
                                            Foreground="#0F172A"
                                            BorderBrush="#CBD5E1"
                                            CornerRadius="22"
                                            Command="{Binding DecreaseMinSocCommand}"/>

                                    <Button Grid.Column="1"
                                            Content="+"
                                            Height="48"
                                            FontSize="23"
                                            FontWeight="Bold"
                                            Background="#ECFDF5"
                                            Foreground="#15803D"
                                            BorderBrush="#BBF7D0"
                                            CornerRadius="22"
                                            Command="{Binding IncreaseMinSocCommand}"/>
                                </Grid>

                                <TextBlock Text="EMS 30009"
                                           FontSize="11"
                                           Foreground="#CBD5E1"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- 시작 / 정지 -->
                        <Grid ColumnDefinitions="2*,1*"
                              ColumnSpacing="14">

                            <Button Grid.Column="0"
                                    Content="방전 시작"
                                    Command="{Binding StartDischargeCommand}"
                                    Height="50"
                                    Background="#2563EB"
                                    Foreground="White"
                                    BorderBrush="#1D4ED8"
                                    FontSize="18"
                                    FontWeight="Bold"/>

                            <Button Grid.Column="1"
                                    Content="정지"
                                    Command="{Binding StopDischargeCommand}"
                                    Height="50"
                                    Background="#111827"
                                    Foreground="White"
                                    BorderBrush="#111827"
                                    FontSize="18"
                                    FontWeight="Bold"/>
                        </Grid>


                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>